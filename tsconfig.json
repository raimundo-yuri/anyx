{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts",
    "tests/browser",
    "build/pwa.ts",
    "playwright.production.config.ts",
    "tests/production",
    "playwright.pages.config.ts",
    "tests/pages"
  ]
}
